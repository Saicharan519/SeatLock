# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# Database (docker compose exposes Postgres on host port 5433)
DATABASE_URL=postgres://seatlock:seatlock@localhost:5433/seatlock
TEST_DATABASE_URL=postgres://seatlock:seatlock@localhost:5433/seatlock_test
PG_POOL_MAX=20
PG_POOL_ACQUIRE_TIMEOUT_MS=30000

REDIS_URL=redis://localhost:6379

# Secrets: required at startup, the process exits if missing
JWT_SECRET=change-me-to-a-long-random-string
WEBHOOK_SECRET=change-me-to-another-long-random-string

API_PORT=3000
HOLD_TTL_SECONDS=300
MAX_SEATS_PER_HOLD=6
WORKER_INTERVAL_MS=5000
OUTBOX_LEASE_SECONDS=60
RATE_LIMIT_ENABLED=true
GATEWAY_URL=http://localhost:4000

# Seed script
SEED_ADMIN_EMAIL=admin@seatlock.local
SEED_ADMIN_PASSWORD=admin12345

# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# Database (docker compose exposes Postgres on host port 5433)
DATABASE_URL=postgres://seatlock:seatlock@localhost:5433/seatlock
TEST_DATABASE_URL=postgres://seatlock:seatlock@localhost:5433/seatlock_test
PG_POOL_MAX=20
PG_POOL_ACQUIRE_TIMEOUT_MS=30000

REDIS_URL=redis://localhost:6379

# Secrets: required at startup, the process exits if missing
JWT_SECRET=change-me-to-a-long-random-string
WEBHOOK_SECRET=change-me-to-another-long-random-string

API_PORT=3000
HOLD_TTL_SECONDS=300
MAX_SEATS_PER_HOLD=6
WORKER_INTERVAL_MS=5000
OUTBOX_LEASE_SECONDS=60
# Rate limiting (Redis). Fails open if Redis is down. Disable for load tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_BOOKING_PER_MINUTE=30
# Only behind a trusted reverse proxy: take the client IP from X-Forwarded-For
TRUST_PROXY=false
GATEWAY_URL=http://localhost:4000

# Seed script
SEED_ADMIN_EMAIL=admin@seatlock.local
SEED_ADMIN_PASSWORD=admin12345

# Hosted deployment only (see docs/deploy.md); leave unset locally
# ORIGIN_SECRET=          # API accepts requests only with this X-Origin-Secret header (min 32 chars)
# CLIENT_IP_HEADER=x-real-ip
# CATALOG_MAINTENANCE_HOURS=6   # worker tops up showtimes / prunes old shows (0 = off)
# SEED_DEMO_EMAIL=demo@seatlock.app
# SEED_DEMO_PASSWORD=

# Cashfree sandbox (optional). With both set, checkout offers Cashfree test mode.
# Locally there are no webhooks (Cashfree can't reach your laptop); the worker's
# reconciliation asks Cashfree for the result instead.
# CASHFREE_APP_ID=TEST...
# CASHFREE_SECRET_KEY=
# SITE_URL=http://localhost:5173

{
  "name": "seatlock",
  "version": "0.1.0",
  "private": true,
  "description": "Ticket-booking backend that guarantees no seat is ever double-booked",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "dev:gateway": "tsx watch apps/mock-gateway/src/index.ts",
    "start:api": "tsx apps/api/src/server.ts",
    "start:worker": "tsx apps/worker/src/index.ts",
    "start:gateway": "tsx apps/mock-gateway/src/index.ts",
    "migrate:up": "node-pg-migrate up -m packages/db/migrations --no-verbose",
    "migrate:down": "node-pg-migrate down -m packages/db/migrations",
    "migrate:create": "node-pg-migrate create -m packages/db/migrations -j sql",
    "seed": "tsx packages/db/src/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}

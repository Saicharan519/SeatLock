{
  "name": "seatlock",
  "version": "0.1.0",
  "private": true,
  "description": "Ticket-booking backend that guarantees no seat is ever double-booked",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,gateway,worker,web -c blue,magenta,yellow,green \"npm:dev:api\" \"npm:dev:gateway\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:db": "docker compose up -d postgres redis",
    "dev:web": "npm --prefix frontend run dev",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "dev:gateway": "tsx watch apps/mock-gateway/src/index.ts",
    "start:api": "tsx apps/api/src/server.ts",
    "start:worker": "tsx apps/worker/src/index.ts",
    "start:gateway": "tsx apps/mock-gateway/src/index.ts",
    "start:all": "tsx apps/all-in-one/src/index.ts",
    "build": "esbuild api=apps/api/src/server.ts worker=apps/worker/src/index.ts gateway=apps/mock-gateway/src/index.ts seed=packages/db/src/seed.ts all=apps/all-in-one/src/index.ts --bundle --platform=node --target=node24 --packages=external --outdir=dist --log-level=warning",
    "migrate:up": "node-pg-migrate up -m packages/db/migrations --no-verbose",
    "migrate:down": "node-pg-migrate down -m packages/db/migrations",
    "migrate:create": "node-pg-migrate create -m packages/db/migrations -j sql",
    "seed": "tsx packages/db/src/seed.ts",
    "db:peek": "tsx packages/db/src/peek.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "demo:race": "tsx demo/race/run.ts",
    "loadtest:spike": "bash tests/k6/run.sh spike",
    "loadtest:steady": "bash tests/k6/run.sh steady"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
